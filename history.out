    1  sudo groupadd students
    2  sudo useradd -u 1234 -G students -m user1
    3  sudo passwd user1
    4  id user1
    5  sudo chage -M 90 user1
    6  sudo chage -l user1
    7  find / -perm -4000 -type f 2>/dev/null > ~/setuid-files.out
    8  cat ~/setuid-files.out
    9  ps -eo pid,ruser,user,cmd > ~/processes.out
   10  cat ~/processes.out
   11  awk '$2 != "root" && $3 == "root"' ~/processes.out
   12  awk '$2 != "root" && $3 == "root"' ~/processes.out > ~/elevated-processes.out
   13  cat /etc/shadow
   14  cat /etc/passwd
   15  cp $(which cat) ~/mycat
   16  sudo chown root:root ~/mycat
   17  sudo chmod u+s ~/mycat
   18  ls -l ~/mycat
   19  ~/mycat /etc/shadow
   20  sudo cp /etc/shadow ~/shadow.copy
   21  touch ~/testfile
   22  chown user1 ~/testfile
   23  cp $(which chown) ~/mychown
   24  sudo setcap cap_chown+ep ~/mychown
   25  getcap ~/mychown
   26  ~/mychown user1 ~/testfile
   27  ls -l ~/testfile
   28  getcap ~/mychown > ~/getcap.out
   29  which timedatectl
   30  sudo visudo
   31  sudo cat /etc/sudoers | tail -5
   32  sudo visudo
   33  sudo cat /etc/sudoers | tail -5
   34  su - user1
   35  sudo visudo
   36  su - user1
   37  sudo timedatectl set-ntp false
   38  su - user1
   39  sudo timedatectl set-ntp true
   40  date
   41  sudo passwd user1
   42  history > ~/history.out
